# --- Core ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Colombo

# mock = fixture-backed (no 3CX needed) | live = headless web client
TCX_MODE=mock

# --- 3CX ----------------------------------------------------------------
TCX_URL=https://your-3cx.example.com
TCX_SERVICE_USER=svc-bridge
TCX_SERVICE_PASSWORD=change-me
# AI extension used in Phase 4 (loaded now so config stays stable)
TCX_AI_EXT=199
TCX_AI_PASSWORD=change-me
# Testing/bootstrap only; normally leave blank and use the credentials above.
TCX_ACCESS_TOKEN=

# Endpoint paths. Defaults follow 3cx.md; override after Phase 0 recon probe.
TCX_EP_CALLS=/xapi/v1/ReportCallLogData/Pbx.GetCallLogData
TCX_EP_RECORDINGS=/xapi/v1/Recordings
TCX_EP_DOWNLOAD=/xapi/v1/Recordings/Pbx.DownloadRecording(recId={id})
TCX_EP_PRESENCE=/xapi/v1/Users

# --- Portal -------------------------------------------------------------
PORTAL_TOKEN=dev-portal-token
PORTAL_API_URL=http://localhost:3000
# Asset URL prefix for signed recording links (e.g. https://bridge.example.com)
PUBLIC_BASE_URL=
# Leave blank to keep webhooks queued (useful in mock/dev).
PORTAL_WEBHOOK_URL=
PORTAL_WEBHOOK_SECRET=dev-webhook-secret

# --- Transcriber (Phase 2) ---------------------------------------------
WORKER_TOKEN=dev-worker-token

# --- ElevenLabs (Phase 4) ----------------------------------------------
ELEVENLABS_MODE=mock
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# off | overflow | always
AI_MODE=overflow
# Start the headless-browser voice bridge watcher (needs Phase 0 recon).
AI_VOICE_ENABLED=0
AI_WATCHDOG_MS=10000
AI_WATCHDOG_INTERVAL_MS=1000

# Knowledge base seed folder, relative to bridge/.
KB_SEED_DIR=../kb
KB_SYNC_INTERVAL_MS=60000

# Optional bearer for the portal's own API.
PORTAL_API_TOKEN=

# --- Phase 5 ops --------------------------------------------------------
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_MS=300000
ALERT_WEBHOOK_URL=
BACKUP_DIR=./data/backups
BACKUP_HOUR=3
BACKUP_MINUTE=0
BACKUP_RETENTION_DAYS=30
RETENTION_AUDIO_DAYS=365
COMPRESS_AUDIO=1
COMPRESS_BITRATE=32k
MAINTENANCE_INTERVAL_MS=60000

# --- Paths / HTTP -------------------------------------------------------
DB_PATH=./data/bridge.db
RECORDINGS_DIR=./data/recordings
CHROMIUM_PROFILE_DIR=./data/chromium
API_HOST=127.0.0.1
API_PORT=8080

# --- Timings (ms) -------------------------------------------------------
POLL_CALLS_MS=120000
POLL_RECORDINGS_MS=120000
POLL_PRESENCE_MS=60000
OUTBOX_INTERVAL_MS=30000
OVERLAP_MS=600000
INITIAL_LOOKBACK_MS=604800000
# --- Behaviour ----------------------------------------------------------
RECORDING_LINK_TTL_SEC=900
DROP_THRESHOLD_SEC=10
# Presence statuses that count as "active time" (comma separated).
ACTIVE_STATUSES=available,ready,online

# --- Summaries (Phase 2) ------------------------------------------------
# mock = deterministic local output (dev) | ollama = local LLM
SUMMARISER=mock
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=60000
SUMMARISER_INTERVAL_MS=30000
# Reset a job left 'running' by a killed worker after this long.
JOB_STALE_MS=1800000

# --- Layer B: Laya native decision server (/predict) --------------------
# Decisions are staged only; they are never written onto leads by this bridge.
# Start ~/DEV/004-RnD/037-laya/playground.sh for the local typed-decisions server.
DECISION_ENABLED=1
DECISION_MODEL=laya
DECISION_INTERVAL_MS=30000
DECISION_MAX_TRANSCRIPT_CHARS=48000
LAYA_BASE_URL=http://127.0.0.1:8000
LAYA_MODEL=typed-decisions
# LAYA_API_KEY=
LAYA_TIMEOUT_MS=120000

# --- Transcriber (read by transcriber/, not the bridge) -----------------
# Engine: fluidvoice | mock | whisper | nemo | auto
TRANSCRIBER_ENGINE=fluidvoice
# FluidVoice local server: Settings > Experimental > Fluid Server
FLUIDVOICE_URL=http://127.0.0.1:8765
FLUIDVOICE_TIMEOUT=180
# Keep only these languages; other detections are skipped without overwriting.
FLUIDVOICE_ALLOWED_LANGUAGES=ta,en,si
# Mono calls: diarize with FluidAudio CLI, then transcribe each speaker turn.
FLUIDVOICE_DIARIZE=1
FLUIDVOICE_DIARIZER=sortformer
FLUIDVOICE_DIARIZER_CLI=~/Developer/FluidAudio/.build/release/fluidaudiocli
FLUIDVOICE_SPEAKER_COUNT=2
# FLUIDVOICE_DIARIZER_TIMEOUT=900
# FLUIDVOICE_LANGUAGE=
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8
# MOCK_LANGUAGE=ta
# PARAKEET_MODEL=/opt/models/parakeet-tamil.nemo
# TRANSCRIBER_DIARISE=1
# TRANSCRIBER_POLL_SECONDS=5
